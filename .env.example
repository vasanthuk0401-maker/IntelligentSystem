# Copy to .env and fill in. The app also works without a key (offline heuristic mode).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional: real job search via Adzuna (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Pipeline tuning
MATCH_THRESHOLD=60
MAX_SEARCH_ITERATIONS=3
